# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/glamora
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/glamora?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=glamora_jwt_secret_key_production_ready_2026
JWT_EXPIRE=7d

# Email Configuration (Nodemailer for OTP delivery)
# Note: For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Configuration (Image Uploads)
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client Application URL
CLIENT_URL=http://localhost:5173
